lab_orders ||--o{ lab_order_tests : orderId

hospital_rooms ||--o{ hospital_admissions : roomId
hospital_admissions ||--o{ hospital_vital_signs : admissionId
hospital_admissions ||--o{ hospital_treatments : admissionId
hospital_admissions ||--o{ hospital_procedures : admissionId

icu_rooms ||--o{ icu_patients : roomId
icu_patients ||--o{ icu_vital_signs : icuPatientId
icu_patients ||--o{ icu_treatments : icuPatientId
icu_patients ||--o{ icu_equipment : icuPatientId

' Relații logice neconstrânse de FK
doctor_access_codes ..> doctors : doctor_name (logic)
doctors_on_duty ..> doctors : doctorName (logic)
appointments ..> doctors : primaryPhysician (logic)
doctor_notifications ..> doctors : doctorName (logic)
doctor_reviews ..> doctors : doctorName (logic)
medical_records ..> doctors : doctorName (logic)
emergency_cases ..> doctors : assignedDoctorId (logic)

@enduml
