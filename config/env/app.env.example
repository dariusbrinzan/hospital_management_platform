# Application runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public URLs and admin access
NEXT_PUBLIC_APP_URL=https://carepulse.example.com
NEXT_PUBLIC_ADMIN_PASSKEY=111111
CRON_SECRET=replace-with-a-long-random-string

# Current persistence mode
DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_PATH=/app/data/carepulse.db
ENABLE_DB_AUTODISCOVERY=true
DATABASE_AUTODISCOVERY_MODE=postgresql-auto
APP_NAMESPACE=carepulse
DB_DISCOVERY_HOSTS=postgresql postgresql.carepulse.svc.cluster.local postgres postgres.carepulse.svc.cluster.local

# Future PostgreSQL migration target
DATABASE_URL=postgresql://carepulse:change-me@postgresql.carepulse.svc.cluster.local:5432/carepulse?sslmode=disable
POSTGRES_HOST=postgresql.carepulse.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=carepulse
POSTGRES_USER=carepulse
POSTGRES_SSLMODE=disable

# Optional integrations
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Redis request cache
ENABLE_REQUEST_CACHE=false
CACHE_PROVIDER=redis
REQUEST_CACHE_DEFAULT_TTL_SECONDS=60
REDIS_HOST=redis.carepulse.svc.cluster.local
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=carepulse
REDIS_PASSWORD=change-me
REDIS_TLS_ENABLED=false
